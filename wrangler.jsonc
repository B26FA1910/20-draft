{
  "name": "20-draft",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ico", "**/*.png"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "DraftRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DraftRoom"] }
  ]
}
